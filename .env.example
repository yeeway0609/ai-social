# 環境（local／preview／production）；debug 由此推導，不另設旗標
NUXT_PUBLIC_ENVIRONMENT=local

# Neon Postgres 連線字串（Dashboard → Connection string → Pooled connection）
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/aisocial?sslmode=require

# session 簽章金鑰
NUXT_SESSION_SECRET=

# 管理端點密鑰；沒設時管理端點回 404
NUXT_ADMIN_SECRET=

# ── 改寫模型 ──
# 走 NVIDIA NIM 的 OpenAI 相容端點（https://build.nvidia.com），金鑰只放伺服器，所有使用者共用
NUXT_AI_NVIDIA_API_KEY=
NUXT_AI_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# 語意相似度用的 embedding 模型，同一把金鑰
NUXT_AI_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
NUXT_AI_TEMPERATURE=1


# 沒有金鑰時的本機替身：改寫只在原文前加語氣標記，讓 UI 流程走得通（true／false）
NUXT_AI_MOCK=false

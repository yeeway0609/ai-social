# 環境（local／preview／production）；debug 由此推導，不另設旗標
NUXT_PUBLIC_ENVIRONMENT=local

# Neon Postgres 連線字串（Dashboard → Connection string → Pooled connection）
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/aisocial?sslmode=require

# 加密使用者自備 API key 的對稱金鑰（32 bytes 的 hex，用 openssl rand -hex 32 產生）
NUXT_CREDENTIAL_SECRET=

# session 簽章金鑰
NUXT_SESSION_SECRET=

# ── 團隊共用金鑰池 ──
# demo 時所有沒自備金鑰的訪客都吃這裡的額度，用完就只剩「自備金鑰」一條路。
# 逗號分隔，可放多把輪替；provider 各自獨立。
NUXT_AI_POOL_ANTHROPIC=
NUXT_AI_POOL_OPENAI=
# OpenRouter 相容 OpenAI 介面，有免費模型（模型名帶 :free），額度看 OpenRouter 帳戶
NUXT_AI_POOL_OPENROUTER=

# 沒指定時預設用哪個 provider 與模型
NUXT_AI_DEFAULT_PROVIDER=anthropic
NUXT_AI_MODEL_ANTHROPIC=claude-haiku-4-5-20251001
NUXT_AI_MODEL_OPENAI=gpt-5-mini
NUXT_AI_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free

# 團隊自架模型（OpenAI Responses 相容端點）。Vercel 連不到內網位址，只能本機開發或經 tunnel 使用
NUXT_AI_POOL_LOCAL=
NUXT_AI_LOCAL_BASE_URL=http://192.168.5.245/ai/v1
NUXT_AI_MODEL_LOCAL=

# 預產改寫的管理端點（POST /api/admin/prerender）用的密鑰；沒設就關閉。用 openssl rand -hex 16 產生
NUXT_ADMIN_SECRET=

# 沒有金鑰時的本機替身：改寫只在原文前加語氣標記，讓 UI 流程走得通（true／false）
NUXT_AI_MOCK=false
